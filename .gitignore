dashboard-web-parental/.env.*.local

# Vercel
dashboard-web-parental/.vercel

# ── OS ───────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Logs ─────────────────────────────
*.log
npm-debug.log*

# ── Build / dist (lokal) ─────────────
dist/

